# ==========================================
# CURAPULSE HEALTHCARE PLATFORM CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=your-secure-jwt-secret-string-2026

# AI / LLM Configuration (Google Gemini API - optional, resilient mock/fallback active if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# Email / SMTP Configuration (Optional, leave blank for Ethereal local test preview)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM="HealthCare Clinic <noreply@healthcare-platform.com>"

# Google Calendar API OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth2callback

